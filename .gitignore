# ── Model weights & compiled artifacts (hosted outside git) ───────────────────
*.h5
*.keras
*.pth
*.pt
*.onnx
*.trt
*.plan
*.engine
*.bin

# ── Datasets & generated media ────────────────────────────────────────────────
*.jpg
*.jpeg
*.png
*.pdf
!documentation/**/*.png

# ── Secrets & machine-local config ────────────────────────────────────────────
# Real .env files never get committed; the *.example templates always do.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# pip.conf points at an internal mirror and is machine-specific.
# The committed template is pip.conf.example.
pip.conf
!pip.conf.example

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.spec
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ── Notebooks ─────────────────────────────────────────────────────────────────
.ipynb_checkpoints

# ── Temporary ─────────────────────────────────────────────────────────────────
*.tmp
*.log
*.v2

# ── External repositories (cloned, not vendored) ──────────────────────────────
pytorch-CycleGAN-and-pix2pix/
