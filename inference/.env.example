# Copy to .env and fill in before `docker compose up`.
#   cp .env.example .env
# .env is gitignored; this template is not.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=signature_db
POSTGRES_USER=signature
# Required. Generate one with: openssl rand -base64 24
POSTGRES_PASSWORD=

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=production

# Browser origins allowed to call the API, comma-separated. Must include the
# origin the frontend is actually served from — by default the nginx container
# on port 8110. Add your host's LAN address for remote access.
CORS_ORIGINS=http://localhost:8110,http://127.0.0.1:8110

# Average cosine distance below which a signature counts as a match.
# 0 = identical, 1 = orthogonal. Calibrate on your own enrolled set:
# `sigtrain evaluate` reports the EER threshold as a cosine *similarity* s;
# set this to 1 - s.
MATCH_THRESHOLD=0.30

# YOLOv8 objectness floor for accepting a detection.
DETECTION_CONFIDENCE=0.5

# Approximate nearest-neighbour candidates.
#   0   exact sequential scan over every enrolled signature (default)
#   100 walk the HNSW index over binary-quantized embeddings for 100 candidates,
#       then re-rank them exactly
# Measured at 4,800 enrolled: 18.5 ms exact vs 0.5 ms at 100 candidates, with
# recall@1 97.5-100% on synthetic data. Off by default because a missed
# neighbour is a false REJECTION here — validate recall on your own enrolled
# set first. See documentation/04-database.md.
ANN_CANDIDATES=0

# ── Upload limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=20

# ── Image build ───────────────────────────────────────────────────────────────
# Public defaults work anywhere. Inside the NVIDIA network, point these at the
# internal mirror instead:
#   API_BASE_IMAGE=10.254.144.152/tessel/python:3.11-slim-bookworm
#   USE_INTERNAL_APT=1
API_BASE_IMAGE=python:3.11-slim-bookworm
USE_INTERNAL_APT=0

# Triton server image. Must be >= the version the ONNX opset requires.
TRITON_IMAGE=nvcr.io/nvidia/tritonserver:24.01-py3
