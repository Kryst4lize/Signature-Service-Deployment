name: "latest_net_G_B"
backend: "onnxruntime"
max_batch_size: 1

input {
  name: "input"
  data_type: TYPE_FP32
  dims: [ 3, 224, 224 ]
}

output {
  name: "output"
  data_type: TYPE_FP32
  # Symbolic, not a mistake. The generator is fully convolutional, so the ONNX
  # tracer cannot prove H_out == H_in and emits dim_params for both spatial
  # axes. torch 2.3 did the same (Tanhoutput_dim_2/3), which is why the original
  # convert_to_trt-generated config also carried [ 3, -1, -1 ].
  # `sigtrain export` regenerates exactly this, so the first export stays a no-op.
  dims: [ 3, -1, -1 ]
}

instance_group [
  {
    kind: KIND_GPU
    gpus: [ 0 ]
    count: 1
  }
]
